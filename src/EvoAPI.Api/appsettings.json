{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YourSecretKeyHereMustBe32CharactersLong!",
    "Issuer": "EvoAPI",
    "Audience": "EvoClient",
    "ExpiryInMinutes": 60,
    "MaxExpiryInMinutes": 1440
  },
  "Authentication": {
    "SeedLogin": 123456,
    "SeedWeek": 3,
    "CookieSecure": true,
    "CookieSameSite": "None",
    "CookieHttpOnly": false,
    "LoginTrackingExpiryDays": 30,
    "XsrfExpirySeconds": 3600
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:evotest.database.windows.net,1433;Initial Catalog=EVO;User ID=EvoUser;Password={DB_PASSWORD};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "GoogleMaps": {
    "ApiKey": "your-google-maps-api-key-here"
  },
  "Fleetmatics": {
    "BaseUrl": "${FLEETMATICS_BASE_URL}",
    "Username": "${FLEETMATICS_USERNAME}",
    "Password": "${FLEETMATICS_PASSWORD}",
    "SyncHour": 2
  },
  "EvoWS": {
    "BaseUrl": "${EVOWS_BASE_URL}"
  },
  "TimeTracking": {
    "SyncIntervalMinutes": 15,
    "LoginTypeId": 1,
    "ClockInTypeId": 2,
    "CheckInTypeId": 3,
    "BreakTypeId": 4
  }
}
